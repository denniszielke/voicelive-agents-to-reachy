# ---------------------------------------------------------------------------
# Environment sample for voicelive-agents-to-reachy
#
# Most of these are written automatically to ./.env by `azd up` (the azure.yaml
# postdeploy hook copies .azure/<env>/.env to ./). Copy this file to ./.env for
# local development, or fill the blanks after provisioning.
#
# Three hosted agents are deployed:
#   orchestrator-agent   — routes turns to the specialists (responses protocol,
#                          VoiceLive binds here; calls specialists via invocations_ws)
#   weather-agent        — outside (outdoor) temperature (invocations_ws)
#   homeassistant-agent  — inside (indoor) temperature (invocations_ws)
#
# NOTE: invocations_ws is a Foundry public-preview feature available ONLY in
# North Central US, so AZURE_LOCATION must be northcentralus.
# ---------------------------------------------------------------------------

# --- azd / deployment (written by azd up) ----------------------------------
AZURE_ENV_NAME=
# Must be northcentralus while invocations_ws is in preview.
AZURE_LOCATION=northcentralus
AZURE_RESOURCE_GROUP=

# --- Foundry project (all apps + agents) -----------------------------------
# Full project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_PROJECT_NAME=

# Model deployment used by the agents
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5.4-mini
OPENAI_API_VERSION=2024-05-01-preview

# Optional telemetry (injected by the Foundry platform for hosted agents)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Container registry (build/deploy scripts) -----------------------------
AZURE_CONTAINER_REGISTRY_ENDPOINT=
AZURE_REGISTRY=

# --- VoiceLive (voice-invocation client + webrtclive server) ---------------
# VoiceLive realtime endpoint: https://<account>.services.ai.azure.com
AZURE_VOICELIVE_ENDPOINT=
# Optional VoiceLive realtime model (custom-invocation-URL mode only)
AZURE_VOICELIVE_MODEL=gpt-realtime

# --- Which agent(s) the VoiceLive front-ends bind to ----------------------
# webrtc_orchestrator shows one tab per agent listed here (comma-separated).
# chat_client and voice-invocation use AZURE_AI_AGENT_NAME (single agent).
# Default to orchestrator-agent so one conversation reaches both specialists.
AZURE_AI_AGENT_NAMES=orchestrator-agent,weather-agent,homeassistant-agent
AZURE_AI_AGENT_NAME=orchestrator-agent
AZURE_AI_HOSTED_AGENT_NAME=orchestrator-agent

# Optional: api-version the orchestrator uses on the invocations_ws upgrade to
# reach the specialists. Without it the gateway rejects the WebSocket (HTTP 400).
AZURE_AI_INVOCATIONS_WS_API_VERSION=2025-11-15-preview

# voice-invocation/client.py custom-backend mode: full /invocations URL.
# e.g. http://localhost:8088/invocations for a locally running agent container.
INVOCATION_URL=
